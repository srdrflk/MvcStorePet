@model MvcStore.Models.Entity.tblUrunler
@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using (Html.BeginForm("Guncelle", "Urun", FormMethod.Post))
{
    @Html.HiddenFor(x => x.Id)
    <label>Ürün adını giriniz...</label>
    @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
    <br />
    <label>Ürün markasını giriniz...</label>
    @Html.TextBoxFor(x => x.Marka, new { @class = "form-control" })
    <br />
    <label>Ürün stok giriniz...</label>
    @Html.TextBoxFor(x => x.Stok, new { @class = "form-control" })
    <br />
    <label>Ürün alış fiyatı giriniz...</label>
    @Html.TextBoxFor(x => x.AlisFiyat, new { @class = "form-control" })
    <br />
    <label>Ürün satış fiyatı giriniz...</label>
    @Html.TextBoxFor(x => x.SatisFiyat, new { @class = "form-control" })
    <br />
    <label>Ürün durum giriniz...</label>
    @*@Html.DropDownListFor(x => x.Durum, (List<SelectListItem>)ViewBag.durum, new { @class = "form-control" })*@
    @Html.DropDownListFor(m => m.Durum, new SelectList(new[]
            {
            new { Value = "true", Text = "Aktif" },
            new { Value = "false", Text = "Pasif" }
        }, "Value", "Text"), "Select Status", new { @class = "form-control" })
    <br />
    <label>Ürün kategori giriniz...</label>
    @Html.DropDownListFor(x => x.tblKategori.Id, (List<SelectListItem>)ViewBag.kat, new { @class = "form-control" })
    <br />
    <button class="btn btn-primary">Güncelle</button>
}
